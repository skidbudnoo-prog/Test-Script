--[[
    AXOMJB - HALLOWEEN AUTOFARM 🎃
    SAFE CANDY TELEPORT
    HALLOWEEN DOOR FARM
    NEARBY ZOMBIE DETECTION
    AUTO RESET ON DAMAGE
    AUTOMATIC RESPAWN RECOVERY
    SERVER HOP + AUTO EXECUTE
]]

local Env = (getgenv and getgenv()) or _G

--==================================================
-- SETTINGS
--==================================================

local ServerHop = Env.ServerHop
if ServerHop == nil then
    ServerHop = false
end

local AutoExecute = ServerHop

--==================================================
-- SERVICES
--==================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIGURATION
--==================================================

local OPEN_WAIT = 3
local CANDY_SCAN_RADIUS = 100
local ZOMBIE_SCAN_RADIUS = 60

local CANDY_TELEPORT_DELAY = 1.5
local CANDY_RETRY_COOLDOWN = 5
local CANDY_GROUND_CHECK_DISTANCE = 80
local CANDY_MAX_GROUND_DROP = 22
local CANDY_MAX_VERTICAL_DIFFERENCE = 15

local TREE_SWITCH_WAIT = 0.5
local SCAN_WAIT = 1

local DOOR_PATTERN = "^DOOR%s*%d+%s+NEW$"

local LOADER_URL =
    "https://raw.githubusercontent.com/skidbudnoo-prog/Test-Script/refs/heads/main/tsbcandy%2Cluau"

--==================================================
-- RUNTIME
--==================================================

local Running = true
local ResetInProgress = false

local DoorRegistry = {}
local CountedCandy = {}
local CandyCooldown = {}
local CharacterConnections = {}

--==================================================
-- CANDY NAMES
--==================================================

local CandyNames = {
    BloxRoll = true,
    BloxyDrops = true,
    Chocoblox = true,

    DarkOrangeCandy1 = true,
    DarkOrangeCandy2 = true,
    DarkOrangeCandy3 = true,
    DarkOrangeCandy4 = true,

    MrBloxBar = true,

    OrangeCandy1 = true,
    OrangeCandy2 = true,
    OrangeCandy3 = true,
    OrangeCandy4 = true
}

--==================================================
-- CHARACTER HELPERS
--==================================================

local function getCharacter()
    return Player.Character
end

local function getHumanoid()
    local character = getCharacter()

    return character
        and character:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local character = getCharacter()

    return character
        and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid = getHumanoid()

    return humanoid ~= nil
        and humanoid.Health > 0
        and getRoot() ~= nil
end

local function waitForAlive()
    while Running do
        if isAlive() then
            return true
        end

        task.wait(0.25)
    end

    return false
end

--==================================================
-- AUTO RESET WHEN TAKING DAMAGE
--==================================================

local function forceReset(humanoid)
    if ResetInProgress or not humanoid then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    ResetInProgress = true

    warn("[AXOMJB] Damage detected! Resetting character...")

    pcall(function()
        humanoid.Health = 0
    end)
end

local function disconnectCharacterConnections()
    for _, connection in ipairs(CharacterConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(CharacterConnections)
end

local function monitorCharacter(character)
    disconnectCharacterConnections()

    if not character then
        return
    end

    local humanoid = character:WaitForChild("Humanoid", 15)

    if not humanoid then
        warn("[AXOMJB] Could not find respawned Humanoid.")
        return
    end

    if Player.Character ~= character then
        return
    end

    local previousHealth = humanoid.Health

    table.insert(
        CharacterConnections,
        humanoid.HealthChanged:Connect(function(newHealth)
            if Player.Character ~= character then
                return
            end

            if newHealth < previousHealth and newHealth > 0 then
                forceReset(humanoid)
            end

            previousHealth = newHealth
        end)
    )

    table.insert(
        CharacterConnections,
        humanoid.Died:Connect(function()
            ResetInProgress = true
            warn("[AXOMJB] Character died. Waiting for respawn...")
        end)
    )

    warn("[AXOMJB] Character damage monitoring active.")
end

Player.CharacterAdded:Connect(function(character)
    ResetInProgress = false

    warn("[AXOMJB] Character respawned. Preparing to resume farming...")

    task.spawn(function()
        monitorCharacter(character)
    end)
end)

if Player.Character then
    task.spawn(function()
        monitorCharacter(Player.Character)
    end)
end

--==================================================
-- AUTOMATIC RESET ON START
--==================================================

local function resetOnStart()
    if not waitForAlive() then
        return false
    end

    local oldCharacter = getCharacter()
    local humanoid = getHumanoid()

    if not oldCharacter or not humanoid then
        return false
    end

    ResetInProgress = true

    warn("[AXOMJB] Performing startup reset...")

    pcall(function()
        humanoid.Health = 0
    end)

    while Running and Player.Character == oldCharacter do
        task.wait(0.25)
    end

    if not Running then
        return false
    end

    ResetInProgress = false

    if not waitForAlive() then
        return false
    end

    warn("[AXOMJB] Startup reset complete. Farming enabled.")

    return true
end

--==================================================
-- OBJECT HELPERS
--==================================================

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- DOOR TELEPORT
--==================================================

local function teleportTo(object)
    if not waitForAlive() then
        return false
    end

    local part = getPart(object)

    if not part or not part:IsDescendantOf(Workspace) then
        return false
    end

    local success = pcall(function()
        local character = getCharacter()

        if not character then
            error("Character missing")
        end

        character:PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 3, 0))
        )
    end)

    if success then
        task.wait(0.8)
    end

    return success
end

--==================================================
-- FACE TREE
--==================================================

local function faceTree(door)
    if not waitForAlive() then
        return false
    end

    local part = getPart(door)
    local root = getRoot()

    if not part or not root then
        return false
    end

    return pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )

        local camera = Workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                part.Position
            )
        end
    end)
end

--==================================================
-- TREE INTERACTION
--==================================================

local function interact(object)
    if not object or not object.Parent then
        return false
    end

    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local success = pcall(function()
            firePrompt(prompt)
        end)

        if success then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end)
end

--==================================================
-- FIND HALLOWEEN DOORS
--==================================================

local function getDoors()
    local folder = Workspace:FindFirstChild(
        "HalloweenDoorTrees"
    )

    if not folder then
        return {}
    end

    local template = folder:FindFirstChild(
        "DoorTreeTemplate"
    )

    if not template then
        return {}
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then

            table.insert(doors, object)
            DoorRegistry[object] = true
        end
    end

    table.sort(doors, function(a, b)
        local aNumber = tonumber(a.Name:match("%d+")) or 0
        local bNumber = tonumber(b.Name:match("%d+")) or 0

        return aNumber < bNumber
    end)

    return doors
end

--==================================================
-- CHECK OPENED DOORS
--==================================================

local function isDoorOpened(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return true
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        return not prompt.Enabled
    end

    return false
end

local function allTreesOpened()
    local total = 0

    for door in pairs(DoorRegistry) do
        if door and door.Parent then
            total = total + 1

            if not isDoorOpened(door) then
                return false, total
            end
        end
    end

    return total > 0, total
end

--==================================================
-- NEARBY ZOMBIE DETECTION
--==================================================

local function getZombies()
    local zombies = {}
    local root = getRoot()

    if not root then
        return zombies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            local part = getPart(object)

            if humanoid
                and humanoid.Health > 0
                and part then

                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= ZOMBIE_SCAN_RADIUS then
                    table.insert(zombies, {
                        Model = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(zombies, function(a, b)
        return a.Distance < b.Distance
    end)

    return zombies
end

--==================================================
-- ATTACK NEARBY ZOMBIES
--==================================================

local function attackZombies()
    if not waitForAlive() then
        return
    end

    local zombies = getZombies()

    for _, entry in ipairs(zombies) do
        if not Running or not waitForAlive() then
            return
        end

        local zombie = entry.Model

        if zombie and zombie.Parent then
            pcall(function()
                local target = getPart(zombie)
                local root = getRoot()

                if not target or not root then
                    return
                end

                local distance =
                    (target.Position - root.Position).Magnitude

                if distance > ZOMBIE_SCAN_RADIUS then
                    return
                end

                root.CFrame = CFrame.lookAt(
                    root.Position,
                    target.Position
                )

                for _ = 1, 5 do
                    if not Running or not zombie.Parent then
                        break
                    end

                    if not waitForAlive() then
                        break
                    end

                    local zombieHumanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not zombieHumanoid
                        or zombieHumanoid.Health <= 0 then
                        break
                    end

                    local character = getCharacter()

                    local tool = character
                        and character:FindFirstChildWhichIsA("Tool")

                    if tool then
                        pcall(function()
                            tool:Activate()
                        end)
                    end

                    task.wait(0.35)
                end
            end)
        end
    end
end

--==================================================
-- FIND THE CLOSEST CANDY PART
--==================================================

local function getCandyPart(object, root)
    if not object or not root then
        return nil
    end

    local bestPart = nil
    local bestDistance = math.huge

    if object:IsA("BasePart") then
        bestPart = object
        bestDistance =
            (object.Position - root.Position).Magnitude
    end

    for _, item in ipairs(object:GetDescendants()) do
        if item:IsA("BasePart") then
            local distance =
                (item.Position - root.Position).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                bestPart = item
            end
        end
    end

    return bestPart
end

--==================================================
-- FIND SAFE GROUND UNDER CANDY
--==================================================

local function getSafeCandyPosition(candy, part)
    if not candy or not part then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        Player.Character,
        candy
    }
    params.RespectCanCollide = true

    local origin = part.Position + Vector3.new(0, 8, 0)

    local direction = Vector3.new(
        0,
        -CANDY_GROUND_CHECK_DISTANCE,
        0
    )

    local result = Workspace:Raycast(
        origin,
        direction,
        params
    )

    if not result then
        return nil
    end

    if result.Material == Enum.Material.Water then
        return nil
    end

    if result.Normal.Y < 0.7 then
        return nil
    end

    if result.Instance:IsA("BasePart")
        and not result.Instance.CanCollide then
        return nil
    end

    local groundDrop =
        part.Position.Y - result.Position.Y

    if groundDrop < -5
        or groundDrop > CANDY_MAX_GROUND_DROP then
        return nil
    end

    local humanoid = getHumanoid()
    local root = getRoot()

    if not humanoid or not root then
        return nil
    end

    local standingHeight =
        humanoid.HipHeight + (root.Size.Y / 2) + 0.5

    return result.Position + Vector3.new(0, standingHeight, 0)
end

--==================================================
-- FIND CLOSEST SAFE CANDY
--==================================================

local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    local seen = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name]
            and not seen[object]
            and not CountedCandy[object] then

            seen[object] = true

            local cooldownUntil = CandyCooldown[object]

            if not cooldownUntil or os.clock() >= cooldownUntil then
                local part = getCandyPart(object, root)

                if part then
                    local verticalDifference =
                        math.abs(part.Position.Y - root.Position.Y)

                    if verticalDifference <= CANDY_MAX_VERTICAL_DIFFERENCE then
                        local safePosition =
                            getSafeCandyPosition(object, part)

                        if safePosition then
                            local distance =
                                (safePosition - root.Position).Magnitude

                            if distance <= CANDY_SCAN_RADIUS then
                                table.insert(candies, {
                                    Object = object,
                                    Part = part,
                                    Position = safePosition,
                                    Distance = distance
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--==================================================
-- SAFE, SLOW CANDY TELEPORT
--==================================================

local function collectCandy()
    if not waitForAlive() then
        return
    end

    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not waitForAlive() then
            return
        end

        local candy = entry.Object
        local part = entry.Part

        if not candy
            or not candy:IsDescendantOf(Workspace)
            or not part
            or not part:IsDescendantOf(Workspace) then
            continue
        end

        local root = getRoot()
        local character = getCharacter()

        if not root or not character then
            return
        end

        local safePosition =
            getSafeCandyPosition(candy, part)

        if not safePosition then
            CandyCooldown[candy] =
                os.clock() + CANDY_RETRY_COOLDOWN

            continue
        end

        local distance =
            (safePosition - root.Position).Magnitude

        if distance > CANDY_SCAN_RADIUS then
            continue
        end

        local success = pcall(function()
            character:PivotTo(CFrame.new(safePosition))
        end)

        if success then
            task.wait(CANDY_TELEPORT_DELAY)
        end

        if not candy:IsDescendantOf(Workspace) then
            CountedCandy[candy] = true
            CandyCooldown[candy] = nil
        else
            CandyCooldown[candy] =
                os.clock() + CANDY_RETRY_COOLDOWN
        end

        return
    end
end

--==================================================
-- HALLOWEEN DOOR FARM
--==================================================

local function farmDoor(door)
    if not Running or not waitForAlive() then
        return
    end

    if not door
        or not door:IsDescendantOf(Workspace)
        or isDoorOpened(door) then
        return
    end

    if not teleportTo(door) then
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(OPEN_WAIT)

    if not Running then
        return
    end

    collectCandy()
end

--==================================================
-- AUTO EXECUTE ON SERVER HOP
--==================================================

local function queueAutoExecute()
    if not AutoExecute then
        return true
    end

    local queueFunction =
        Env.queue_on_teleport
        or Env.queueonteleport

    if type(queueFunction) ~= "function"
        and type(Env.syn) == "table" then

        queueFunction = Env.syn.queue_on_teleport
    end

    if type(queueFunction) ~= "function" then
        return false
    end

    local loaderCode =
        'loadstring(game:HttpGet("' .. LOADER_URL .. '"))()'

    local success = pcall(function()
        queueFunction(loaderCode)
    end)

    return success
end

--==================================================
-- SERVER HOP
--==================================================

local function serverHop()
    if not ServerHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            if not queueAutoExecute() then
                return false
            end

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                return true
            end
        end
    end

    return false
end

--==================================================
-- STARTUP OPTIMIZATIONS
--==================================================

--==================================================
-- RESET BEFORE STARTING FARM
--==================================================

if not resetOnStart() then
    return
end

--==================================================
-- MAIN FARM LOOP
--==================================================

warn("[AXOMJB] Halloween Autofarm started!")

while Running do
    local success, err = pcall(function()
        if not waitForAlive() then
            return
        end

        -- Collect one closest safe candy.
        collectCandy()

        if not Running then
            return
        end

        -- Find and farm doors.
        local doors = getDoors()

        for _, door in ipairs(doors) do
            if not Running or not waitForAlive() then
                return
            end

            if door
                and door:IsDescendantOf(Workspace)
                and not isDoorOpened(door) then

                farmDoor(door)
            end

            task.wait(TREE_SWITCH_WAIT)
        end

        if not Running then
            return
        end

        -- Collect another candy after door farming.
        collectCandy()

        -- Attack nearby zombies.
        attackZombies()

        -- Server hop after doors are opened.
        if ServerHop then
            local completed, total = allTreesOpened()

            if completed and total > 0 then
                if serverHop() then
                    Running = false
                    return
                end
            end
        end
    end)

    if not success then
        warn(
            "[AXOMJB] Farm recovered from error:",
            tostring(err)
        )
    end

    task.wait(SCAN_WAIT)
end
