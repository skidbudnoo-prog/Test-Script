        FarmButton.Text = "AUTOFARM: ON"
        FarmButton.BackgroundColor3 = GREEN
        StatusLabel.Text = "● RUNNING"
        StatusLabel.TextColor3 = GREEN
    else
        FarmButton.Text = "AUTOFARM: OFF"
        FarmButton.BackgroundColor3 = RED
        StatusLabel.Text = "● STOPPED"
        StatusLabel.TextColor3 = RED
    end
end

--// STOP
local function stopFarm()
    if not Running then
        return
    end

    Running = false
    ElapsedTime = os.clock() - StartTime
    updateGui()
end

--// START
local function startFarm()
    if Running then
        return
    end

    Running = true
    WorkerId = WorkerId + 1

    local thisWorker = WorkerId

    StartTime = os.clock() - ElapsedTime
    updateGui()

    task.spawn(function()
        while Running and WorkerId == thisWorker do
            local success = pcall(function()
                if not isAlive() then
                    task.wait(RECOVERY_WAIT)
                    return
                end

                -- Collect candy while farming.
                collectCandy()

                if not Running or WorkerId ~= thisWorker then
                    return
                end

                -- Scan current server's doors.
                local doors = getDoors()

                if doors == nil then
                    task.wait(RECOVERY_WAIT)
                    return
                end

                -- Farm only doors not confirmed opened.
                for _, door in ipairs(doors) do
                    if not Running or WorkerId ~= thisWorker then
                        break
                    end

                    if door and not isDoorOpened(door) then
                        farmDoor(door)
                    end

                    task.wait(TREE_SWITCH_WAIT)
                end

                if not Running or WorkerId ~= thisWorker then
                    return
                end

                -- HOP ONLY AFTER ALL REGISTERED TREES ARE OPENED.
                if AutoHop then
                    local completed, total = allTreesOpened()

                    if completed and total > 0 then
                        local hopped = serverHop()

                        if hopped then
                            return
                        end

                        -- Avoid repeatedly requesting a hop.
                        task.wait(RECOVERY_WAIT)
                    end
                end
            end)

            if not success then
                task.wait(RECOVERY_WAIT)
            end

            task.wait(0.1)
        end
    end)
end

