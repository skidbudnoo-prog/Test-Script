--==================================================
-- CHARACTER FUNCTIONS
--==================================================

local function getCharacter()
    return Player.Character
end

local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid = getHumanoid()
    return humanoid ~= nil
        and humanoid.Health > 0
        and getRoot() ~= nil
end

local function waitForAlive()
    while Running do
        if isAlive() then
            CurrentStatus = "RUNNING"
            return true
        end

        CurrentStatus = "WAITING FOR RESPAWN"
        task.wait(0.25)
    end

    return false
end

Player.CharacterAdded:Connect(function()
    if Running then
        CurrentStatus = "CHARACTER RESPAWNED"
        task.wait(1)
        CurrentStatus = "RUNNING"
    end
end)

--==================================================
-- OBJECT FUNCTIONS
--==================================================

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- TELEPORT
--==================================================

local function teleportTo(object)
    if not waitForAlive() then
        return false
    end

    local part = getPart(object)

    if not part then
        return false
    end

    local character = getCharacter()

    if not character then
        return false
    end

    local success, err = pcall(function()
        character:PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)

    if not success then
        LastError = tostring(err)
        return false
    end

    task.wait(CANDY_WAIT)
    return true
end

--==================================================
-- FACE TREE
--==================================================

local function faceTree(door)
    if not waitForAlive() then
        return false
    end

    local part = getPart(door)
    local root = getRoot()

    if not part or not root then
        return false
    end

    local success = pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )

        local camera = Workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                part.Position
            )
        end
    end)

    return success
end

--==================================================
-- TREE INTERACTION
--==================================================

local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local success = pcall(function()
            firePrompt(prompt)
        end)

        if success then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, HOLD_TIME))
        prompt:InputHoldEnd()
    end)
end

--==================================================
-- FIND TREES
--==================================================

local function getDoors()
    local folder = Workspace:FindFirstChild("HalloweenDoorTrees")

    if not folder then
        return nil
    end

    local template = folder:FindFirstChild("DoorTreeTemplate")

    if not template then
        return nil
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN) and getPart(object) then
            table.insert(doors, object)
            DoorRegistry[object] = true
        end
    end

    table.sort(doors, function(a, b)
        local aNumber = tonumber(a.Name:match("%d+")) or 0
        local bNumber = tonumber(b.Name:match("%d+")) or 0

        return aNumber < bNumber
    end)

    return doors
end

local function isDoorOpened(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return true
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        return not prompt.Enabled
    end

    return false
end

local function allTreesOpened()
    local total = 0

    for door in pairs(DoorRegistry) do
        total = total + 1

        if not isDoorOpened(door) then
            return false, total
        end
    end

    return total > 0, total
end

--==================================================
-- CANDY SCANNER
--==================================================

local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name] then
            local part = getPart(object)

            if part then
                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= CANDY_SCAN_RADIUS then
                    table.insert(candies, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--==================================================
-- COLLECT CANDY
--==================================================

local function collectCandy()
    if not waitForAlive() then
        return
    end

    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running then
            return
        end

        if not waitForAlive() then
            return
        end

        local candy = entry.Object

        if candy
            and candy.Parent
            and candy:IsDescendantOf(Workspace)
            and not CountedCandy[candy] then

            local success = teleportTo(candy)

            if success then
                task.wait(0.3)

                if not candy:IsDescendantOf(Workspace) then
                    CountedCandy[candy] = true
                    CandyCount = CandyCount + 1
                end
            end
        end
    end
end

--==================================================
-- ZOMBIES
--==================================================

local function getZombies()
    local zombies = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(zombies, object)
            end
        end
    end

    return zombies
end

local function attackZombies()
    if not KillZombies then
        return
    end

    for _, zombie in ipairs(getZombies()) do
        if not Running or not waitForAlive() then
            return
        end

        local target = getPart(zombie)

        if target then
            local character = getCharacter()
            local root = getRoot()

            if character and root then
                pcall(function()
                    root.CFrame = CFrame.lookAt(
                        root.Position,
                        target.Position
                    )

                    local tool =
                        character:FindFirstChildWhichIsA("Tool")

                    if tool then
                        for _ = 1, 5 do
                            if not Running or not zombie.Parent then
                                break
                            end

                            if not waitForAlive() then
                                break
                            end

                            local humanoid =
                                zombie:FindFirstChildWhichIsA("Humanoid")

                            if not humanoid or humanoid.Health <= 0 then
                                break
                            end

                            tool:Activate()
                            task.wait(0.35)
                        end
                    end
                end)
            end
        end
    end
end

--==================================================
-- FARM ONE TREE
--==================================================

local function farmDoor(door)
    if not Running or not door then
        return
    end

    if not waitForAlive() then
        return
    end

    if not door:IsDescendantOf(Workspace)
        or isDoorOpened(door) then
        return
    end

    CurrentStatus = "FARMING TREE"

    if not teleportTo(door) then
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(OPEN_WAIT)

    if not Running then
        return
    end

    collectCandy()
    attackZombies()
end

--==================================================
-- AUTO EXECUTE QUEUE
--==================================================

local function queueAutoExecute()
    if not AutoExecute then
        return true
    end

    local queueFunction =
        Env.queue_on_teleport
        or Env.queueonteleport

    if type(queueFunction) ~= "function" then
        if type(Env.syn) == "table" then
            queueFunction = Env.syn.queue_on_teleport
        end
    end

    if type(queueFunction) ~= "function" then
        CurrentStatus = "EXECUTOR QUEUE NOT SUPPORTED"
        return false
    end

    local code =
        'loadstring(game:HttpGet("' .. LOADER_URL .. '"))()'

    local success = pcall(function()
        queueFunction(code)
    end)

    return success
end

--==================================================
-- SERVER HOP
--==================================================

local function serverHop()
    if not AutoHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        CurrentStatus = "REQUEST FUNCTION UNAVAILABLE"
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        CurrentStatus = "SERVER SEARCH FAILED"
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        CurrentStatus = "SERVER SEARCH FAILED"
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        CurrentStatus = "INVALID SERVER DATA"
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            if not queueAutoExecute() then
                return false
            end

            CurrentStatus = "SERVER HOPPING"

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                return true
            end
        end
    end

    CurrentStatus = "NO AVAILABLE SERVER"
    return false
end

