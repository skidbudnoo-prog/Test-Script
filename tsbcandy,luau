--// CHARACTER
local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    return getCharacter():WaitForChild("HumanoidRootPart")
end

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function isAlive()
    local character = Player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

--// TELEPORT
local function teleportTo(object)
    local part = getPart(object)

    if not part then
        return false
    end

    local success = pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)

    if success then
        task.wait(CANDY_WAIT)
    end

    return success
end

--// FACE TREE
local function faceTree(door)
    local part = getPart(door)

    if not part then
        return false
    end

    return pcall(function()
        local root = getRoot()
        local target = part.Position

        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(target.X, root.Position.Y, target.Z)
        )

        local camera = Workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                target
            )
        end
    end)
end

--// PROXIMITY PROMPT
local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local fired = pcall(function()
            firePrompt(prompt)
        end)

        if fired then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, HOLD_TIME))
        prompt:InputHoldEnd()
    end)
end

--// FIND HALLOWEEN DOORS
local function getDoors()
    local folder = Workspace:FindFirstChild("HalloweenDoorTrees")

    if not folder then
        return nil
    end

    local template = folder:FindFirstChild("DoorTreeTemplate")

    if not template then
        return nil
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN) and getPart(object) then
            table.insert(doors, object)
            DoorRegistry[object] = true
        end
    end

    table.sort(doors, function(a, b)
        local aNumber = tonumber(a.Name:match("%d+")) or 0
        local bNumber = tonumber(b.Name:match("%d+")) or 0

        return aNumber < bNumber
    end)

    return doors
end

--// CHECK IF A TREE IS OPENED
-- A removed door or disabled prompt counts as opened.
-- If the game does not expose either state, completion
-- cannot safely be confirmed and AutoHop will wait.
local function isDoorOpened(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return true
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        return not prompt.Enabled
    end

    return false
end

--// CHECK ALL REGISTERED TREES
local function allTreesOpened()
    local total = 0

    for door in pairs(DoorRegistry) do
        total = total + 1

        if not isDoorOpened(door) then
            return false, total
        end
    end

    return total > 0, total
end

--// FIND NEARBY CANDY
local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    local playerPosition = root.Position

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name] then
            local part = getPart(object)

            if part then
                local distance =
                    (part.Position - playerPosition).Magnitude

                if distance <= CANDY_SCAN_RADIUS then
                    table.insert(candies, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--// COLLECT CANDY
local function collectCandy()
    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not isAlive() then
            return
        end

        local candy = entry.Object

        if candy and candy:IsDescendantOf(Workspace) then
            local success = teleportTo(candy)

            if success then
                if not candy:IsDescendantOf(Workspace) then
                    CandyCount = CandyCount + 1
                end
            end
        end
    end
end

--// FIND ZOMBIES
local function getZombies()
    local zombies = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(zombies, object)
            end
        end
    end

    return zombies
end

--// ZOMBIE ATTACK
local function attackZombies()
    if not KillZombies then
        return
    end

    for _, zombie in ipairs(getZombies()) do
        if not Running or not isAlive() then
            return
        end

        pcall(function()
            local target = getPart(zombie)

            if not target then
                return
            end

            local character = getCharacter()
            local root = getRoot()

            root.CFrame = CFrame.lookAt(
                root.Position,
                target.Position
            )

            local tool = character:FindFirstChildWhichIsA("Tool")

            if tool then
                for _ = 1, 5 do
                    if not Running or not zombie.Parent then
                        break
                    end

                    local humanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not humanoid or humanoid.Health <= 0 then
                        break
                    end

                    tool:Activate()
                    task.wait(0.35)
                end
            end
        end)
    end
end

--// SERVER HOP
local function serverHop()
    if not AutoHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                return true
            end
        end
    end

    return false
end

--// OPTIMIZATION SCRIPTS
local function loadOptimization(url)
    if type(loadstring) ~= "function" then
        return
    end

    pcall(function()
        local source = game:HttpGet(url)
        local compiled = loadstring(source)

        if compiled then
            compiled()
        end
    end)
end

