--// GETGENV SETTINGS
-- Configure these in your executor if needed:
-- getgenv().AutoHop = true
-- getgenv().KillZombies = true

local function autoHopEnabled()
    return Env.AutoHop == true
end

local function zombieKillEnabled()
    return Env.KillZombies ~= false
end

--// CHARACTER
local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    return getCharacter():FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local character = Player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--// TELEPORT
local function teleportTo(object)
    local part = getPart(object)
    if not part then
        return false
    end

    return pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)
end

--// INTERACT
local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local success = pcall(function()
            firePrompt(prompt)
        end)

        if success then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, SETTINGS.HoldTime))
        prompt:InputHoldEnd()
    end)
end

--// FACE TREE
local function faceTree(door)
    local part = getPart(door)
    local root = getRoot()

    if not part or not root then
        return
    end

    pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )
    end)
end

--// FIND DOORS
local function getDoors()
    local folder = Workspace:FindFirstChild("HalloweenDoorTrees")
    if not folder then
        return {}
    end

    local template = folder:FindFirstChild("DoorTreeTemplate")
    if not template then
        return {}
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN) and getPart(object) then
            table.insert(doors, object)
        end
    end

    table.sort(doors, function(a, b)
        local an = tonumber(a.Name:match("%d+")) or 0
        local bn = tonumber(b.Name:match("%d+")) or 0
        return an < bn
    end)

    return doors
end

--// FIND CANDY
local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name] then
            local part = getPart(object)

            if part then
                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= SETTINGS.CandyRadius then
                    table.insert(candies, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--// COLLECT CANDY
local function collectCandy()
    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not isAlive() then
            return
        end

        local candy = entry.Object

        if candy and candy:IsDescendantOf(Workspace) then
            local success = teleportTo(candy)

            if success then
                task.wait(SETTINGS.CandyWait)

                -- Approximate claimed count:
                -- increments when the object disappears from Workspace.
                if not candy:IsDescendantOf(Workspace) then
                    CandyCount = CandyCount + 1
                end
            end
        end
    end
end

--// FIND ZOMBIES
local function getZombies()
    local zombies = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model")
            and object.Name == "HalloweenZombie" then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(zombies, object)
            end
        end
    end

    return zombies
end

--// ATTACK ZOMBIES
local function attackZombies()
    if not zombieKillEnabled() then
        return
    end

    for _, zombie in ipairs(getZombies()) do
        if not Running or not isAlive() then
            return
        end

        pcall(function()
            local target = getPart(zombie)
            local root = getRoot()

            if not target or not root then
                return
            end

            root.CFrame = CFrame.lookAt(
                root.Position,
                target.Position
            )

            local character = getCharacter()
            local tool = character:FindFirstChildWhichIsA("Tool")

            if not tool then
                return
            end

            for _ = 1, SETTINGS.ZombieAttackCount do
                if not Running or not zombie.Parent then
                    break
                end

                local humanoid =
                    zombie:FindFirstChildWhichIsA("Humanoid")

                if not humanoid or humanoid.Health <= 0 then
                    break
                end

                tool:Activate()
                task.wait(SETTINGS.ZombieAttackDelay)
            end
        end)
    end
end

--// SERVER HOP
local function serverHop()
    if not autoHopEnabled() then
        return false
    end

    local requestFunction =
        Env.request or Env.http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            local teleported = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleported then
                return true
            end
        end
    end

    return false
end

--// FARM TREE
local function farmDoor(door)
    if not Running
        or not door
        or not door:IsDescendantOf(Workspace)
        or not isAlive() then
        return
    end

    if not teleportTo(door) then
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(SETTINGS.OpenWait)

    if Running and zombieKillEnabled() then
        attackZombies()
    end
end

