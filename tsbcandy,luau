
--// AXOMJB - HALLOWEEN AUTOFARM
--// Continuous Candy Scanner + Camera Facing + Door Farm

local Env = (getgenv and getgenv()) or _G

--// LOADER CONFIG
local AutoExecute = Env.AutoExecute
if AutoExecute == nil then AutoExecute = true end

local AutoHop = Env.AutoHop
if AutoHop == nil then AutoHop = false end

local KillZombies = Env.KillZombies
if KillZombies == nil then KillZombies = true end

--// SERVICES
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--// SETTINGS
local HOLD_TIME = 4.5
local OPEN_WAIT = 3
local RECOVERY_WAIT = 2
local CANDY_NAME = "Candys"
local CANDY_SCAN_INTERVAL = 2
local DOOR_PATTERN = "^DOOR%s*%d+%s+NEW$"

local CandyScanning = true
local CandyLoopRunning = false

--// CHARACTER
local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    return getCharacter():WaitForChild("HumanoidRootPart")
end

local function getPart(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function isAlive()
    local humanoid =
        getCharacter():FindFirstChildWhichIsA("Humanoid")

    return humanoid ~= nil and humanoid.Health > 0
end

--// TELEPORT
local function teleportTo(object)
    local part = getPart(object)
    if not part then return false end

    local success = pcall(function()
        getCharacter():PivotTo(
            part.CFrame * CFrame.new(0, 2, 4)
        )
    end)

    if not success then return false end

    task.wait(0.5)
    return true
end

--// CAMERA FACING TREE
local function faceTree(door)
    local part = getPart(door)
    if not part then return false end

    local camera = Workspace.CurrentCamera
    if not camera then return false end

    local root = getRoot()
    local target = part.Position

    -- Face character toward tree
    pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(target.X, root.Position.Y, target.Z)
        )
    end)

    -- Face actual camera toward tree
    pcall(function()
        camera.CFrame = CFrame.lookAt(
            camera.CFrame.Position,
            target
        )
    end)

    return true
end

--// HOLD E
local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt and prompt.Enabled then
        local began = false

        local success = pcall(function()
            prompt:InputHoldBegin()
            began = true

            task.wait(math.max(HOLD_TIME, prompt.HoldDuration))

            prompt:InputHoldEnd()
        end)

        if began then
            return success
        end
    end

    local pressed = pcall(function()
        VirtualInputManager:SendKeyEvent(
            true, Enum.KeyCode.E, false, game
        )
    end)

    if not pressed then return false end

    task.wait(HOLD_TIME)

    pcall(function()
        VirtualInputManager:SendKeyEvent(
            false, Enum.KeyCode.E, false, game
        )
    end)

    return true
end

--// FIND DOORS
local function getDoors()
    local folder = Workspace:FindFirstChild("HalloweenDoorTrees")
    if not folder then return {} end

    local template = folder:FindFirstChild("DoorTreeTemplate")
    if not template then return {} end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then
            table.insert(doors, object)
        end
    end

    table.sort(doors, function(a, b)
        local numA = tonumber(a.Name:match("%d+")) or 0
        local numB = tonumber(b.Name:match("%d+")) or 0
        return numA < numB
    end)

    return doors
end

--// FIND ALL CANDYS IN WORKSPACE
local function getCandies()
    local candies = {}
    local seen = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name:lower() == CANDY_NAME:lower() then
            local part = getPart(object)

            if part and not seen[part] then
                seen[part] = true
                table.insert(candies, object)
            end
        end
    end

    return candies
end

--// TELEPORT TO CANDY
local function collectCandy()
    local candies = getCandies()

    print("[CandyFarm] Found:", #candies)

    for _, candy in ipairs(candies) do
        if not isAlive() then return end

        if candy:IsDescendantOf(Workspace) then
            local part = getPart(candy)

            if part then
                pcall(function()
                    getCharacter():PivotTo(
                        CFrame.new(part.Position + Vector3.new(0, 2, 0))
                    )
                end)

                task.wait(1)
            end
        end
    end
end

--// CONTINUOUS CANDY SCANNER
local function startCandyScanner()
    if CandyLoopRunning then return end
    CandyLoopRunning = true

    task.spawn(function()
        while CandyScanning do
            local success, err = pcall(function()
                local candies = getCandies()

                if #candies > 0 then
                    print("[CandyScanner] Candy objects:", #candies)

                    -- Only collect while not actively opening a door.
                    if not Env._AxomFarmingDoor then
                        collectCandy()
                    end
                end
            end)

            if not success then
                warn("[CandyScanner]", tostring(err))
            end

            task.wait(CANDY_SCAN_INTERVAL)
        end

        CandyLoopRunning = false
    end)
end

--// ZOMBIES
local function getZombies()
    local zombies = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(zombies, object)
            end
        end
    end

    return zombies
end

local function attackZombies()
    if not KillZombies then return end

    for _, zombie in ipairs(getZombies()) do
        if not isAlive() then return end

        pcall(function()
            local target = getPart(zombie)
            if not target then return end

            local character = getCharacter()
            local root = getRoot()

            root.CFrame = CFrame.lookAt(
                root.Position,
                target.Position
            )

            local tool = character:FindFirstChildWhichIsA("Tool")

            if tool then
                for _ = 1, 5 do
                    if not zombie.Parent then break end

                    local humanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not humanoid or humanoid.Health <= 0 then
                        break
                    end

                    tool:Activate()
                    task.wait(0.35)
                end
            end
        end)
    end
end

--// SERVER HOP
local function serverHop()
    if not AutoHop then return false end

    local requestFunction =
        Env.request or Env.http_request or request or http_request

    if type(requestFunction) ~= "function" then
        warn("[ServerHop] HTTP unavailable")
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        warn("[ServerHop] Request failed")
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        warn("[ServerHop] HTTP error")
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess then
        warn("[ServerHop] Invalid response")
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            local successTeleport = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if successTeleport then
                print("[ServerHop] Joining server")
                return true
            end
        end
    end

    return false
end

--// OPTIMIZATIONS
local function loadOptimization(url, name)
    if type(loadstring) ~= "function" then
        warn("[Optimization] loadstring unavailable")
        return
    end

    local success, err = pcall(function()
        local source = game:HttpGet(url)
        local compiled = loadstring(source)

        if not compiled then
            error("Compile failed")
        end

        compiled()
    end)

    if not success then
        warn("[Optimization] " .. name .. ": " .. tostring(err))
    end
end

task.spawn(function()
    loadOptimization(
        "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/FixLag.luau",
        "FixLag"
    )

    loadOptimization(
        "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/NoRender.luau",
        "NoRender"
    )
end)

--// FARM DOOR
local function farmDoor(door)
    if not door or not door.Parent or not isAlive() then
        return
    end

    local part = getPart(door)
    if not part then return end

    Env._AxomFarmingDoor = true

    -- Move near tree
    teleportTo(door)

    -- Turn camera toward tree
    faceTree(door)

    task.wait(0.5)

    -- Hold E
    interact(door)

    task.wait(OPEN_WAIT)

    Env._AxomFarmingDoor = false

    -- Refresh candy list after opening door
    collectCandy()

    -- Optional zombie combat
    attackZombies()
end

--// START
print("[AxomJB] Halloween Autofarm Started")
print("[AxomJB] AutoHop:", AutoHop)
print("[AxomJB] KillZombies:", KillZombies)

startCandyScanner()

--// MAIN FARM LOOP
while true do
    local success, err = pcall(function()
        local doors = getDoors()

        if #doors == 0 then
            task.wait(RECOVERY_WAIT)
            return
        end

        for _, door in ipairs(doors) do
            if not isAlive() then
                task.wait(RECOVERY_WAIT)
                return
            end

            if door and door.Parent then
                farmDoor(door)
            end

            task.wait(0.3)
        end

        if AutoHop then
            serverHop()
            task.wait(RECOVERY_WAIT)
        end
    end)

    Env._AxomFarmingDoor = false

    if not success then
        warn("[HalloweenFarm]", tostring(err))
        task.wait(RECOVERY_WAIT)
    end
end
