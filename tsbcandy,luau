--// TIMER FORMAT
local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))

    local minutes = math.floor(seconds / 60)
    local remaining = seconds % 60

    return string.format("%02d:%02d", minutes, remaining)
end

local function setStatus(text, color)
    StatusLabel.Text = "● " .. string.upper(text)
    StatusLabel.TextColor3 = color
end

local function updateFarmButton()
    if Running then
        FarmButton.Text = "AUTOFARM: ON"
        FarmButton.BackgroundColor3 = GREEN
        setStatus("RUNNING", GREEN)
    else
        FarmButton.Text = "AUTOFARM: OFF"
        FarmButton.BackgroundColor3 = RED
        setStatus("STOPPED", RED)
    end
end

--// STOP AUTOFARM
local function stopFarm()
    if not Running then
        return
    end

    Running = false
    ElapsedTime = os.clock() - StartTime
    updateFarmButton()
end

--// START AUTOFARM
local function startFarm()
    if Running then
        return
    end

    Running = true
    WorkerId = WorkerId + 1

    local thisWorker = WorkerId

    StartTime = os.clock() - ElapsedTime
    updateFarmButton()

    task.spawn(function()
        while Running and WorkerId == thisWorker do
            local success = pcall(function()
                if not isAlive() then
                    task.wait(SETTINGS.RecoveryWait)
                    return
                end

                -- Collect nearby candy.
                collectCandy()

                if not Running or WorkerId ~= thisWorker then
                    return
                end

                -- Farm every available tree.
                local doors = getDoors()

                for _, door in ipairs(doors) do
                    if not Running or WorkerId ~= thisWorker then
                        break
                    end

                    if door and door:IsDescendantOf(Workspace) then
                        farmDoor(door)
                    end

                    task.wait(SETTINGS.TreeSwitchWait)
                end

                -- AutoHop uses the existing getgenv setting.
                if Running and autoHopEnabled() then
                    serverHop()
                    task.wait(SETTINGS.RecoveryWait)
                end
            end)

            if not success then
                task.wait(SETTINGS.RecoveryWait)
            end

            task.wait(0.1)
        end
    end)
end

