--// FARM ONE TREE
local function farmDoor(door)
    if not Running
        or not door
        or not door:IsDescendantOf(Workspace)
        or not isAlive() then
        return
    end

    if isDoorOpened(door) then
        return
    end

    if not teleportTo(door) then
        return
    end

    faceTree(door)

    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)

    task.wait(OPEN_WAIT)

    if not Running then
        return
    end

    collectCandy()
    attackZombies()
end

