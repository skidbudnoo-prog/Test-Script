local Env = (getgenv and getgenv()) or _G

--// LOADER SETTINGS
local AutoExecute = Env.AutoExecute
if AutoExecute == nil then AutoExecute = true end

local AutoHop = Env.AutoHop
if AutoHop == nil then AutoHop = false end

local KillZombies = Env.KillZombies
if KillZombies == nil then KillZombies = true end

--// SERVICES
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer

--// SETTINGS
local HOLD_TIME = 0
local OPEN_WAIT = 3
local RECOVERY_WAIT = 2
local CANDY_WAIT = 0.5
local CANDY_SCAN_RADIUS = 100
local TREE_SWITCH_WAIT = 0.3
local DOOR_PATTERN = "^DOOR%s*%d+%s+NEW$"

--// CANDY NAMES
local CandyNames = {
    BloxRoll = true,
    BloxyDrops = true,
    Chocoblox = true,
    DarkOrangeCandy1 = true,
    DarkOrangeCandy2 = true,
    DarkOrangeCandy3 = true,
    DarkOrangeCandy4 = true,
    MrBloxBar = true,
    OrangeCandy1 = true,
    OrangeCandy2 = true,
    OrangeCandy3 = true,
    OrangeCandy4 = true
}

--// CHARACTER
local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    return getCharacter():WaitForChild("HumanoidRootPart")
end

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function isAlive()
    local humanoid =
        getCharacter():FindFirstChildWhichIsA("Humanoid")

    return humanoid ~= nil and humanoid.Health > 0
end

--// TELEPORT
local function teleportTo(object)
    local part = getPart(object)

    if not part then
        return false
    end

    local success = pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)

    if not success then
        return false
    end

    task.wait(CANDY_WAIT)
    return true
end

--// FACE TREE
local function faceTree(door)
    local part = getPart(door)

    if not part then
        return false
    end

    local success = pcall(function()
        local root = getRoot()
        local target = part.Position

        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                target.X,
                root.Position.Y,
                target.Z
            )
        )

        local camera = Workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                target
            )
        end
    end)

    return success
end

--// INSTANT PROXIMITY PROMPT ATTEMPT
local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt and prompt.Enabled then
        local firePrompt = Env.fireproximityprompt
            or fireproximityprompt

        if type(firePrompt) == "function" then
            local fired = pcall(function()
                firePrompt(prompt)
            end)

            if fired then
                return true
            end
        end

        local success = pcall(function()
            prompt:InputHoldBegin()
            prompt:InputHoldEnd()
        end)

        if success then
            return true
        end
    end

    --// KEYBOARD FALLBACK
    local pressed = pcall(function()
        VirtualInputManager:SendKeyEvent(
            true,
            Enum.KeyCode.E,
            false,
            game
        )
    end)

    if not pressed then
        return false
    end

    task.wait(0)

    pcall(function()
        VirtualInputManager:SendKeyEvent(
            false,
            Enum.KeyCode.E,
            false,
            game
        )
    end)

    return true
end

--// FIND HALLOWEEN DOORS
local function getDoors()
    local folder =
        Workspace:FindFirstChild("HalloweenDoorTrees")

    if not folder then
        return {}
    end

    local template =
        folder:FindFirstChild("DoorTreeTemplate")

    if not template then
        return {}
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then

            table.insert(doors, object)
        end
    end

    table.sort(doors, function(a, b)
        local aNumber = tonumber(a.Name:match("%d+")) or 0
        local bNumber = tonumber(b.Name:match("%d+")) or 0

        return aNumber < bNumber
    end)

    return doors
end

--// FIND ONLY NAMED CANDIES NEAR PLAYER
local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    local playerPosition = root.Position

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name] then
            local part = getPart(object)

            if part then
                local distance =
                    (part.Position - playerPosition).Magnitude

                if distance <= CANDY_SCAN_RADIUS then
                    table.insert(candies, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    print("[CandyFarm] Nearby candy found:", #candies)

    return candies
end

--// COLLECT NEARBY CANDIES
local function collectCandy()
    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not isAlive() then
            return
        end

        local candy = entry.Object

        if candy and candy:IsDescendantOf(Workspace) then
            local part = getPart(candy)

            if part then
                print(
                    "[CandyFarm] Nearby:",
                    candy.Name,
                    "Distance:",
                    math.floor(entry.Distance)
                )

                pcall(function()
                    getCharacter():PivotTo(
                        CFrame.new(
                            part.Position + Vector3.new(0, 2, 0)
                        )
                    )
                end)

                task.wait(CANDY_WAIT)
            end
        end
    end
end

--// FIND HALLOWEEN ZOMBIES
local function getZombies()
    local zombies = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(zombies, object)
            end
        end
    end

    return zombies
end

--// ZOMBIE ATTACK
local function attackZombies()
    if not KillZombies then
        return
    end

    for _, zombie in ipairs(getZombies()) do
        if not isAlive() then
            return
        end

        pcall(function()
            local target = getPart(zombie)

            if not target then
                return
            end

            local character = getCharacter()
            local root = getRoot()

            root.CFrame = CFrame.lookAt(
                root.Position,
                target.Position
            )

            local tool =
                character:FindFirstChildWhichIsA("Tool")

            if tool then
                for _ = 1, 5 do
                    if not zombie.Parent then
                        break
                    end

                    local humanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not humanoid or humanoid.Health <= 0 then
                        break
                    end

                    tool:Activate()
                    task.wait(0.35)
                end
            end
        end)
    end
end

--// SERVER HOP
local function serverHop()
    if not AutoHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        warn("[ServerHop] HTTP request unavailable")
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        warn("[ServerHop] Could not retrieve servers")
        return false
    end

    local status = response.StatusCode or response.Status

    if status ~= 200 then
        warn("[ServerHop] HTTP status:", status)
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        warn("[ServerHop] Invalid server response")
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                print("[ServerHop] Joining another server")
                return true
            end
        end
    end

    warn("[ServerHop] No available server found")
    return false
end

--// OPTIMIZATION SCRIPTS
local function loadOptimization(url, name)
    if type(loadstring) ~= "function" then
        warn("[Optimization] loadstring unavailable")
        return
    end

    local success, err = pcall(function()
        local source = game:HttpGet(url)
        local compiled = loadstring(source)

        if not compiled then
            error("Failed to compile " .. name)
        end

        compiled()
    end)

    if not success then
        warn("[Optimization] " .. name .. ": " .. tostring(err))
    end
end

task.spawn(function()
    loadOptimization(
        "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/FixLag.luau",
        "FixLag"
    )

    loadOptimization(
        "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/NoRender.luau",
        "NoRender"
    )
end)

--// FARM ONE TREE
local function farmDoor(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return
    end

    if not isAlive() then
        return
    end

    local part = getPart(door)

    if not part then
        return
    end

    print("[HalloweenFarm] Farming:", door.Name)

    teleportTo(door)
    faceTree(door)

    task.wait(0.4)

    interact(door)

    task.wait(OPEN_WAIT)

    collectCandy()
    attackZombies()
end

--// MAIN FARM LOOP
print("[AxomJB] Halloween Autofarm Started")
print("[AxomJB] AutoExecute:", AutoExecute)
print("[AxomJB] AutoHop:", AutoHop)
print("[AxomJB] KillZombies:", KillZombies)

while true do
    local success, err = pcall(function()
        collectCandy()

        local doors = getDoors()

        if #doors == 0 then
            warn("[HalloweenFarm] No doors found")
            task.wait(RECOVERY_WAIT)
            return
        end

        print("[HalloweenFarm] Doors found:", #doors)

        for _, door in ipairs(doors) do
            if not isAlive() then
                task.wait(RECOVERY_WAIT)
                return
            end

            if door and door:IsDescendantOf(Workspace) then
                farmDoor(door)
            end

            --// TREE SWITCH DELAY: 0.3 SECONDS
            task.wait(TREE_SWITCH_WAIT)
        end

        if AutoHop then
            serverHop()
            task.wait(RECOVERY_WAIT)
        end
    end)

    if not success then
        warn("[HalloweenFarm] Error:", tostring(err))
        task.wait(RECOVERY_WAIT)
    end
end
