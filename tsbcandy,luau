        FarmButton.BackgroundColor3 = RED
    end
end

--==================================================
-- FARM CONTROL
--==================================================

local function stopFarm()
    if not Running then
        return
    end

    Running = false
    ElapsedTime = os.clock() - StartTime
    CurrentStatus = "STOPPED"

    updateGui()
end

local function startFarm()
    if Running then
        return
    end

    Running = true
    WorkerId = WorkerId + 1

    local thisWorker = WorkerId

    StartTime = os.clock() - ElapsedTime
    CurrentStatus = "RUNNING"

    updateGui()

    task.spawn(function()
        while Running and WorkerId == thisWorker do

            -- Candy farming
            local candySuccess, candyError = pcall(function()
                collectCandy()
            end)

            if not candySuccess then
                LastError = tostring(candyError)
                CurrentStatus = "CANDY ERROR"
            end

            if not Running or WorkerId ~= thisWorker then
                break
            end

            if not waitForAlive() then
                break
            end

            -- Tree farming
            local doors

            local doorSuccess, doorError = pcall(function()
                doors = getDoors()
            end)

            if not doorSuccess then
                LastError = tostring(doorError)
                CurrentStatus = "TREE SCAN ERROR"
            end

            if doors then
                for _, door in ipairs(doors) do
                    if not Running or WorkerId ~= thisWorker then
                        break
                    end

                    if not waitForAlive() then
                        break
                    end

                    if door and not isDoorOpened(door) then
                        local success, err = pcall(function()
                            farmDoor(door)
                        end)

                        if not success then
                            LastError = tostring(err)
                            CurrentStatus = "TREE FARM ERROR"
                        end
                    end

                    task.wait(TREE_SWITCH_WAIT)
                end
            else
                CurrentStatus = "WAITING FOR TREE FOLDER"
            end

            if not Running or WorkerId ~= thisWorker then
                break
            end

            -- AutoHop only when all registered trees are opened
            if AutoHop then
                local completed, total = allTreesOpened()

                if completed and total > 0 then
                    if serverHop() then
                        return
                    end

                    task.wait(RECOVERY_WAIT)
                end
            end

            task.wait(0.2)
        end
    end)
end

