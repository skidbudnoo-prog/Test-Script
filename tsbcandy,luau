local Players = game:GetService("Players")
local player = Players.LocalPlayer
local folder = workspace:WaitForChild("HalloweenCandy")
local camera = workspace.CurrentCamera

local status = Drawing.new("Text")
status.Text = "Finding candy..."
status.Size = 18
status.Center = true
status.Outline = true
status.Color = Color3.fromRGB(255, 255, 255)
status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
status.Visible = true

game:GetService("RunService").RenderStepped:Connect(function()
    camera = workspace.CurrentCamera
    status.Position = Vector2.new(camera.ViewportSize.X / 2, 35)
end)

while task.wait() do
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        status.Text = "Waiting for character..."
        continue
    end

    local closestCandy
    local closestDistance = math.huge

    for _, candy in ipairs(folder:GetChildren()) do
        local rest = candy:GetAttribute("Rest")

        if rest then
            local distance = (root.Position - rest.Position).Magnitude

            if distance < closestDistance then
                closestDistance = distance
                closestCandy = rest
            end
        end
    end

    if closestCandy then
        status.Text = "Collecting candy..."
        root.CFrame = CFrame.new(closestCandy.Position + Vector3.new(0, 4, 0))
    else
        status.Text = "No candy - Idle"
        root.CFrame = CFrame.new(0, 100, 0)
    end
end
