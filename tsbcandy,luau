--// START AUTOFARM
local function startFarm()
    if Running then
        return
    end

    Running = true
    WorkerId = WorkerId + 1

    local thisWorker = WorkerId

    StartTime = os.clock() - ElapsedTime
    setStatus("RUNNING", GREEN)

    task.spawn(function()
        while Running and WorkerId == thisWorker do
            local success = pcall(function()
                if not isAlive() then
                    task.wait(SETTINGS.RecoveryWait)
                    return
                end

                -- Candy collection is optional.
                if SETTINGS.CandyFarm then
                    collectCandy()
                end

                -- Tree farming always runs while Autofarm is started.
                local doors = getDoors()

                for _, door in ipairs(doors) do
                    if not Running or WorkerId ~= thisWorker then
                        break
                    end

                    if door and door:IsDescendantOf(Workspace) then
                        farmDoor(door)
                    end

                    -- Default tree switching delay: 0.3 seconds.
                    task.wait(SETTINGS.TreeSwitchWait)
                end

                -- AutoHop is optional.
                if SETTINGS.AutoHop and Running then
                    serverHop()
                    task.wait(SETTINGS.RecoveryWait)
                end
            end)

            if not success then
                task.wait(SETTINGS.RecoveryWait)
            end

            task.wait(0.1)
        end
    end)
end

--// STOP AUTOFARM
local function stopFarm()
    if not Running then
        return
    end

    Running = false
    ElapsedTime = os.clock() - StartTime
    setStatus("STOPPED", RED)
end

