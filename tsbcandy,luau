
--[[
    AXOMJB - HALLOWEEN AUTOFARM 🎃
    NO UI | AUTO RESET | CANDY FARM
    HALLOWEEN DOOR FARM | NEARBY ZOMBIES
    DEATH RECOVERY | AUTO EXECUTE | SERVER HOP
]]

local Env = (getgenv and getgenv()) or _G

--==================================================
-- SETTINGS
--==================================================

local AutoExecute = Env.AutoExecute
if AutoExecute == nil then AutoExecute = true end

-- Supports both ServerHop and AutoHop.
local AutoHop = Env.ServerHop
if AutoHop == nil then
    AutoHop = Env.AutoHop
end
if AutoHop == nil then AutoHop = false end

--==================================================
-- SERVICES
--==================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIGURATION
--==================================================

local OPEN_WAIT = 3
local CANDY_WAIT = 0.5
local CANDY_SCAN_RADIUS = 100
local ZOMBIE_SCAN_RADIUS = 60
local TREE_SWITCH_WAIT = 0.3
local RECOVERY_WAIT = 2
local SCAN_WAIT = 1

local DOOR_PATTERN = "^DOOR%s*%d+%s+NEW$"

local LOADER_URL =
    "https://raw.githubusercontent.com/skidbudnoo-prog/Test-Script/refs/heads/main/tsbcandy%2Cluau"

local FIXLAG_URL =
    "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/FixLag.luau"

local NORENDER_URL =
    "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/NoRender.luau"

--==================================================
-- RUNTIME
--==================================================

local Running = true
local DoorRegistry = {}
local CountedCandy = {}

local LastError = nil

--==================================================
-- CANDY NAMES
--==================================================

local CandyNames = {
    BloxRoll = true,
    BloxyDrops = true,
    Chocoblox = true,

    DarkOrangeCandy1 = true,
    DarkOrangeCandy2 = true,
    DarkOrangeCandy3 = true,
    DarkOrangeCandy4 = true,

    MrBloxBar = true,

    OrangeCandy1 = true,
    OrangeCandy2 = true,
    OrangeCandy3 = true,
    OrangeCandy4 = true
}

--==================================================
-- CHARACTER HELPERS
--==================================================

local function getCharacter()
    return Player.Character
end

local function getHumanoid()
    local character = getCharacter()

    return character
        and character:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local character = getCharacter()

    return character
        and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid = getHumanoid()

    return humanoid ~= nil
        and humanoid.Health > 0
        and getRoot() ~= nil
end

local function waitForAlive()
    while Running do
        if isAlive() then
            return true
        end

        task.wait(0.25)
    end

    return false
end

--==================================================
-- AUTOMATIC RESET ON SCRIPT LOAD
--==================================================

local function resetOnStart()
    if not waitForAlive() then
        return false
    end

    local oldCharacter = getCharacter()
    local humanoid = getHumanoid()

    if not oldCharacter or not humanoid then
        return false
    end

    -- Reset once when the script starts.
    pcall(function()
        humanoid.Health = 0
        humanoid:ChangeState(
            Enum.HumanoidStateType.Dead
        )
    end)

    -- Wait for the replacement character.
    while Running and Player.Character == oldCharacter do
        task.wait(0.25)
    end

    -- Wait until the new character is usable.
    return waitForAlive()
end

--==================================================
-- OBJECT HELPERS
--==================================================

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- TELEPORT
--==================================================

local function teleportTo(object)
    if not waitForAlive() then
        return false
    end

    local part = getPart(object)

    if not part or not part:IsDescendantOf(Workspace) then
        return false
    end

    local success = pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)

    if success then
        task.wait(CANDY_WAIT)
    end

    return success
end

--==================================================
-- FACE TREE
--==================================================

local function faceTree(door)
    if not waitForAlive() then
        return false
    end

    local part = getPart(door)
    local root = getRoot()

    if not part or not root then
        return false
    end

    return pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )

        local camera = Workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                part.Position
            )
        end
    end)
end

--==================================================
-- TREE INTERACTION
--==================================================

local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local success = pcall(function()
            firePrompt(prompt)
        end)

        if success then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end)
end

--==================================================
-- FIND HALLOWEEN DOORS
--==================================================

local function getDoors()
    local folder = Workspace:FindFirstChild(
        "HalloweenDoorTrees"
    )

    if not folder then
        return {}
    end

    local template = folder:FindFirstChild(
        "DoorTreeTemplate"
    )

    if not template then
        return {}
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then

            table.insert(doors, object)
            DoorRegistry[object] = true
        end
    end

    table.sort(doors, function(a, b)
        local aNumber = tonumber(a.Name:match("%d+")) or 0
        local bNumber = tonumber(b.Name:match("%d+")) or 0

        return aNumber < bNumber
    end)

    return doors
end

--==================================================
-- CHECK OPENED DOORS
--==================================================

local function isDoorOpened(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return true
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        return not prompt.Enabled
    end

    return false
end

local function allTreesOpened()
    local total = 0

    for door in pairs(DoorRegistry) do
        total = total + 1

        if not isDoorOpened(door) then
            return false, total
        end
    end

    return total > 0, total
end

--==================================================
-- FIND NEARBY ZOMBIES
--==================================================

local function getZombies()
    local zombies = {}
    local root = getRoot()

    if not root then
        return zombies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            local part = getPart(object)

            if humanoid
                and humanoid.Health > 0
                and part then

                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= ZOMBIE_SCAN_RADIUS then
                    table.insert(zombies, {
                        Model = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(zombies, function(a, b)
        return a.Distance < b.Distance
    end)

    return zombies
end

--==================================================
-- ATTACK NEARBY ZOMBIES
--==================================================

local function attackZombies()
    if not waitForAlive() then
        return
    end

    local zombies = getZombies()

    for _, entry in ipairs(zombies) do
        if not Running or not waitForAlive() then
            return
        end

        local zombie = entry.Model

        if zombie and zombie.Parent then
            pcall(function()
                local target = getPart(zombie)
                local root = getRoot()

                if not target or not root then
                    return
                end

                -- Recheck distance before attacking.
                local distance =
                    (target.Position - root.Position).Magnitude

                if distance > ZOMBIE_SCAN_RADIUS then
                    return
                end

                root.CFrame = CFrame.lookAt(
                    root.Position,
                    target.Position
                )

                for _ = 1, 5 do
                    if not Running or not zombie.Parent then
                        break
                    end

                    if not waitForAlive() then
                        break
                    end

                    local zombieHumanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not zombieHumanoid
                        or zombieHumanoid.Health <= 0 then
                        break
                    end

                    local character = getCharacter()

                    local tool = character
                        and character:FindFirstChildWhichIsA("Tool")

                    if tool then
                        pcall(function()
                            tool:Activate()
                        end)
                    end

                    task.wait(0.35)
                end
            end)
        end
    end
end

--==================================================
-- FIND CANDY
--==================================================

local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name] then
            local part = getPart(object)

            if part then
                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= CANDY_SCAN_RADIUS then
                    table.insert(candies, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--==================================================
-- CANDY FARM + ZOMBIES
--==================================================

local function collectCandy()
    if not waitForAlive() then
        return
    end

    -- Check for zombies even when no candy exists.
    attackZombies()

    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not waitForAlive() then
            return
        end

        local candy = entry.Object

        if candy
            and candy:IsDescendantOf(Workspace)
            and not CountedCandy[candy] then

            teleportTo(candy)

            if candy and not candy:IsDescendantOf(Workspace) then
                CountedCandy[candy] = true
            end

            -- Keep detecting zombies while collecting.
            attackZombies()
        end
    end
end

--==================================================
-- HALLOWEEN DOOR FARM + ZOMBIES
--==================================================

local function farmDoor(door)
    if not Running or not waitForAlive() then
        return
    end

    if not door
        or not door:IsDescendantOf(Workspace)
        or isDoorOpened(door) then
        return
    end

    attackZombies()

    if not teleportTo(door) then
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(OPEN_WAIT)

    if not Running then
        return
    end

    collectCandy()
    attackZombies()
end

--==================================================
-- AUTO EXECUTE ON TELEPORT
--==================================================

local function queueAutoExecute()
    if not AutoExecute then
        return true
    end

    local queueFunction =
        Env.queue_on_teleport
        or Env.queueonteleport

    if type(queueFunction) ~= "function"
        and type(Env.syn) == "table" then

        queueFunction = Env.syn.queue_on_teleport
    end

    if type(queueFunction) ~= "function" then
        return false
    end

    local loaderCode =
        'loadstring(game:HttpGet("' .. LOADER_URL .. '"))()'

    return pcall(function()
        queueFunction(loaderCode)
    end)
end

--==================================================
-- SERVER HOP
--==================================================

local function serverHop()
    if not AutoHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            if not queueAutoExecute() then
                return false
            end

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                return true
            end
        end
    end

    return false
end

--==================================================
-- OPTIMIZATION SCRIPTS
--==================================================

local function loadOptimization(url)
    if type(loadstring) ~= "function" then
        return
    end

    pcall(function()
        local source = game:HttpGet(url)
        local compiled = loadstring(source)

        if compiled then
            compiled()
        end
    end)
end

--==================================================
-- STARTUP
--==================================================

-- Reset once, then wait for the new character.
if not resetOnStart() then
    return
end

--==================================================
-- MAIN FARM LOOP
--==================================================

task.spawn(function()
    while Running do
        local success, err = pcall(function()
            if not waitForAlive() then
                return
            end

            -- Always check nearby zombies.
            attackZombies()

            -- Search and collect candy.
            collectCandy()

            if not Running then
                return
            end

            -- Search for doors again every cycle.
            local doors = getDoors()

            for _, door in ipairs(doors) do
                if not Running or not waitForAlive() then
                    return
                end

                if door
                    and door:IsDescendantOf(Workspace)
                    and not isDoorOpened(door) then

                    farmDoor(door)
                end

                -- Continue checking nearby zombies.
                attackZombies()

                task.wait(TREE_SWITCH_WAIT)
            end

            if not Running then
                return
            end

            -- Search for candy and zombies again.
            collectCandy()
            attackZombies()

            -- Only hop when enabled and all registered doors are open.
            if AutoHop then
                local completed, total = allTreesOpened()

                if completed and total > 0 then
                    if serverHop() then
                        Running = false
                        return
                    end
                end
            end
        end)

        if not success then
            LastError = tostring(err)
            warn("[AXOMJB] Farm recovered from error:", LastError)
        end

        -- Never permanently stop just because a scan found nothing.
        task.wait(SCAN_WAIT)
    end
end)

--==================================================
-- LOAD OPTIMIZATIONS
--==================================================

task.spawn(function()
    task.wait(2)
    loadOptimization(FIXLAG_URL)

    task.wait(1)
    loadOptimization(NORENDER_URL)
end)
