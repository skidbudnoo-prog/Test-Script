
--[[
    AXOMJB - HALLOWEEN AUTOFARM 🎃
    SAFE CANDY TELEPORT
    DYNAMIC HALLOWEEN TREE DETECTION
    NEARBY ZOMBIE DETECTION + COMBAT
    COLLECT CANDY AFTER ZOMBIE FIGHT
    NO FORCED RESET
    SERVER HOP + AUTO EXECUTE
]]

local Env = (getgenv and getgenv()) or _G

--==================================================
-- SETTINGS
--==================================================

local ServerHop = Env.ServerHop
if ServerHop == nil then
    ServerHop = false
end

local AutoExecute = ServerHop

--==================================================
-- SERVICES
--==================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIGURATION
--==================================================

local OPEN_WAIT = 3

local CANDY_SCAN_RADIUS = 100
local ZOMBIE_SCAN_RADIUS = 60
local ZOMBIE_SCAN_INTERVAL = 0.5

local ZOMBIE_ATTACKS = 5
local ZOMBIE_ATTACK_DELAY = 0.35
local ZOMBIE_ATTACK_COOLDOWN = 3

local CANDY_TELEPORT_DELAY = 1.5
local CANDY_RETRY_COOLDOWN = 5
local CANDY_GROUND_CHECK_DISTANCE = 80
local CANDY_MAX_GROUND_DROP = 22
local CANDY_MAX_VERTICAL_DIFFERENCE = 15

local SCAN_WAIT = 1
local DOOR_DISCOVERY_IDLE = 20
local DOOR_RETRY_COOLDOWN = 5

local DOOR_PATTERN = "^DOOR%s*%d+%s+NEW$"

local LOADER_URL =
    "https://raw.githubusercontent.com/skidbudnoo-prog/Test-Script/refs/heads/main/tsbcandy%2Cluau"

local FIXLAG_URL =
    "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/FixLag.luau"

local NORENDER_URL =
    "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/NoRender.luau"

--==================================================
-- RUNTIME
--==================================================

local Running = true

local DoorRegistry = setmetatable({}, {__mode = "k"})
local DoorCooldown = setmetatable({}, {__mode = "k"})
local CountedCandy = setmetatable({}, {__mode = "k"})
local CandyCooldown = setmetatable({}, {__mode = "k"})
local ZombieAttackCooldown = setmetatable({}, {__mode = "k"})

local NearbyZombies = {}
local PreviousZombieCount = -1
local LastDoorDiscovery = os.clock()

--==================================================
-- CANDY NAMES
--==================================================

local CandyNames = {
    BloxRoll = true,
    BloxyDrops = true,
    Chocoblox = true,

    DarkOrangeCandy1 = true,
    DarkOrangeCandy2 = true,
    DarkOrangeCandy3 = true,
    DarkOrangeCandy4 = true,

    MrBloxBar = true,

    OrangeCandy1 = true,
    OrangeCandy2 = true,
    OrangeCandy3 = true,
    OrangeCandy4 = true
}

--==================================================
-- CHARACTER HELPERS
--==================================================

local function getCharacter()
    return Player.Character
end

local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid = getHumanoid()

    return humanoid ~= nil
        and humanoid.Health > 0
        and getRoot() ~= nil
end

local function waitForAlive()
    while Running do
        if isAlive() then
            return true
        end

        task.wait(0.25)
    end

    return false
end

--==================================================
-- OBJECT HELPERS
--==================================================

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- ZOMBIE DETECTION
--==================================================

local function isZombieModel(object)
    if not object or not object:IsA("Model") then
        return false
    end

    return string.find(
        string.lower(object.Name),
        "zombie",
        1,
        true
    ) ~= nil
end

local function scanNearbyZombies()
    local found = {}
    local root = getRoot()

    if not root then
        NearbyZombies = found
        return
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if isZombieModel(object) then
            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            local part =
                object:FindFirstChild("HumanoidRootPart")
                or getPart(object)

            if humanoid and humanoid.Health > 0 and part then
                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= ZOMBIE_SCAN_RADIUS then
                    table.insert(found, {
                        Model = object,
                        Humanoid = humanoid,
                        Distance = distance
                    })
                end
            end
        end
    end

    NearbyZombies = found

    if #found ~= PreviousZombieCount then
        PreviousZombieCount = #found

        if #found > 0 then
            print("[AXOMJB] Nearby zombies detected:", #found)
        else
            print("[AXOMJB] No nearby zombies.")
        end
    end
end

--==================================================
-- ZOMBIE COMBAT
-- Uses currently equipped Tool.
-- Does not teleport to zombies.
--==================================================

local function getEquippedWeapon()
    local character = getCharacter()

    if not character then
        return nil
    end

    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Tool") then
            return object
        end
    end

    return nil
end

local function getClosestZombie()
    local root = getRoot()

    if not root then
        return nil
    end

    local closest = nil
    local closestDistance = ZOMBIE_SCAN_RADIUS

    for _, entry in ipairs(NearbyZombies) do
        local zombie = entry.Model
        local humanoid = entry.Humanoid
        local part = zombie and (
            zombie:FindFirstChild("HumanoidRootPart")
            or getPart(zombie)
        )

        if zombie
            and zombie:IsDescendantOf(Workspace)
            and humanoid
            and humanoid.Health > 0
            and part then

            local distance =
                (part.Position - root.Position).Magnitude

            if distance <= closestDistance then
                closestDistance = distance

                closest = {
                    Model = zombie,
                    Humanoid = humanoid,
                    Distance = distance
                }
            end
        end
    end

    return closest
end

local function fightNearbyZombie()
    if not waitForAlive() then
        return false
    end

    -- Refresh detection before fighting.
    pcall(scanNearbyZombies)

    local target = getClosestZombie()

    if not target then
        return false
    end

    local zombie = target.Model

    local cooldownUntil = ZombieAttackCooldown[zombie]

    if cooldownUntil and os.clock() < cooldownUntil then
        return false
    end

    local weapon = getEquippedWeapon()

    if not weapon then
        warn("[AXOMJB] Zombie nearby, but no weapon is equipped.")
        return false
    end

    print("[AXOMJB] Fighting nearby zombie:", zombie.Name)

    ZombieAttackCooldown[zombie] =
        os.clock() + ZOMBIE_ATTACK_COOLDOWN

    for i = 1, ZOMBIE_ATTACKS do
        if not Running or not isAlive() then
            break
        end

        if not zombie:IsDescendantOf(Workspace) then
            break
        end

        if not target.Humanoid
            or target.Humanoid.Health <= 0 then
            break
        end

        -- Stop if the weapon is no longer equipped.
        if weapon.Parent ~= getCharacter() then
            break
        end

        pcall(function()
            weapon:Activate()
        end)

        task.wait(ZOMBIE_ATTACK_DELAY)
    end

    print("[AXOMJB] Zombie fight finished. Checking nearby candy.")

    -- Refresh zombie list after the fight.
    pcall(scanNearbyZombies)

    return true
end

-- Independent scanner. It does not attack or interrupt farming.
task.spawn(function()
    while Running do
        pcall(scanNearbyZombies)
        task.wait(ZOMBIE_SCAN_INTERVAL)
    end
end)

--==================================================
-- TELEPORT HELPERS
--==================================================

local function teleportTo(object)
    if not waitForAlive() then
        return false
    end

    local part = getPart(object)

    if not part or not part:IsDescendantOf(Workspace) then
        return false
    end

    local success = pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 3, 0))
        )
    end)

    if success then
        task.wait(0.8)
    end

    return success
end

local function faceTree(door)
    if not waitForAlive() then
        return false
    end

    local part = getPart(door)
    local root = getRoot()

    if not part or not root then
        return false
    end

    return pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )
    end)
end

--==================================================
-- TREE INTERACTION
--==================================================

local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local success = pcall(function()
            firePrompt(prompt)
        end)

        if success then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end)
end

--==================================================
-- DOOR STATUS
--==================================================

local function isDoorOpened(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return true
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        return not prompt.Enabled
    end

    return false
end

--==================================================
-- DYNAMIC HALLOWEEN DOOR SCANNER
--==================================================

local function getDoors()
    local folder = Workspace:FindFirstChild(
        "HalloweenDoorTrees"
    )

    if not folder then
        return {}
    end

    local doors = {}
    local root = getRoot()

    for _, object in ipairs(folder:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then

            if not DoorRegistry[object] then
                DoorRegistry[object] = true
                LastDoorDiscovery = os.clock()

                print(
                    "[AXOMJB] New Halloween door detected:",
                    object.Name
                )
            end

            if not isDoorOpened(object) then
                local cooldownUntil = DoorCooldown[object]

                if not cooldownUntil
                    or os.clock() >= cooldownUntil then

                    local part = getPart(object)
                    local distance = math.huge

                    if root and part then
                        distance =
                            (part.Position - root.Position).Magnitude
                    end

                    table.insert(doors, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(doors, function(a, b)
        return a.Distance < b.Distance
    end)

    return doors
end

local function allTreesOpened()
    local total = 0

    for door in pairs(DoorRegistry) do
        total = total + 1

        if not isDoorOpened(door) then
            return false, total
        end
    end

    return total > 0, total
end

--==================================================
-- CANDY HELPERS
--==================================================

local function getCandyPart(object, root)
    if not object or not root then
        return nil
    end

    local bestPart = nil
    local bestDistance = math.huge

    if object:IsA("BasePart") then
        bestPart = object
        bestDistance =
            (object.Position - root.Position).Magnitude
    end

    for _, item in ipairs(object:GetDescendants()) do
        if item:IsA("BasePart") then
            local distance =
                (item.Position - root.Position).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                bestPart = item
            end
        end
    end

    return bestPart
end

local function getSafeCandyPosition(candy, part)
    if not candy or not part then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        Player.Character,
        candy
    }
    params.RespectCanCollide = true

    local origin = part.Position + Vector3.new(0, 8, 0)

    local result = Workspace:Raycast(
        origin,
        Vector3.new(0, -CANDY_GROUND_CHECK_DISTANCE, 0),
        params
    )

    if not result then
        return nil
    end

    if result.Material == Enum.Material.Water then
        return nil
    end

    if result.Normal.Y < 0.7 then
        return nil
    end

    if result.Instance:IsA("BasePart")
        and not result.Instance.CanCollide then
        return nil
    end

    local groundDrop =
        part.Position.Y - result.Position.Y

    if groundDrop < -5
        or groundDrop > CANDY_MAX_GROUND_DROP then
        return nil
    end

    local humanoid = getHumanoid()
    local root = getRoot()

    if not humanoid or not root then
        return nil
    end

    local standingHeight =
        humanoid.HipHeight + (root.Size.Y / 2) + 0.5

    return result.Position
        + Vector3.new(0, standingHeight, 0)
end

local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    local seen = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name]
            and not seen[object]
            and not CountedCandy[object] then

            seen[object] = true

            local cooldownUntil = CandyCooldown[object]

            if not cooldownUntil or os.clock() >= cooldownUntil then
                local part = getCandyPart(object, root)

                if part then
                    local verticalDifference =
                        math.abs(part.Position.Y - root.Position.Y)

                    if verticalDifference <= CANDY_MAX_VERTICAL_DIFFERENCE then
                        local safePosition =
                            getSafeCandyPosition(object, part)

                        if safePosition then
                            local distance =
                                (safePosition - root.Position).Magnitude

                            if distance <= CANDY_SCAN_RADIUS then
                                table.insert(candies, {
                                    Object = object,
                                    Part = part,
                                    Position = safePosition,
                                    Distance = distance
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--==================================================
-- COLLECT CANDY
--==================================================

local function collectCandy()
    if not waitForAlive() then
        return
    end

    -- Always make a fresh scan when this function is called.
    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not waitForAlive() then
            return
        end

        local candy = entry.Object
        local part = entry.Part

        if not candy
            or not candy:IsDescendantOf(Workspace)
            or not part
            or not part:IsDescendantOf(Workspace) then
            continue
        end

        local root = getRoot()
        local character = getCharacter()

        if not root or not character then
            return
        end

        local safePosition =
            getSafeCandyPosition(candy, part)

        if not safePosition then
            CandyCooldown[candy] =
                os.clock() + CANDY_RETRY_COOLDOWN
            continue
        end

        local distance =
            (safePosition - root.Position).Magnitude

        if distance > CANDY_SCAN_RADIUS then
            continue
        end

        local success = pcall(function()
            character:PivotTo(CFrame.new(safePosition))
        end)

        if success then
            task.wait(CANDY_TELEPORT_DELAY)
        end

        if not candy:IsDescendantOf(Workspace) then
            CountedCandy[candy] = true
            CandyCooldown[candy] = nil
        else
            CandyCooldown[candy] =
                os.clock() + CANDY_RETRY_COOLDOWN
        end

        -- One candy per call, then scan again next loop.
        return
    end
end

--==================================================
-- FARM ONE DOOR
--==================================================

local function farmDoor(door)
    if not Running or not waitForAlive() then
        return
    end

    if not door
        or not door:IsDescendantOf(Workspace)
        or isDoorOpened(door) then
        return
    end

    if not teleportTo(door) then
        DoorCooldown[door] =
            os.clock() + DOOR_RETRY_COOLDOWN
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(OPEN_WAIT)

    if isDoorOpened(door) then
        DoorCooldown[door] = nil
        print("[AXOMJB] Door opened:", door.Name)
    else
        DoorCooldown[door] =
            os.clock() + DOOR_RETRY_COOLDOWN

        warn("[AXOMJB] Door did not open; will retry:", door.Name)
    end

    -- Check candy after interacting with a tree too.
    collectCandy()
end

--==================================================
-- AUTO EXECUTE
--==================================================

local function queueAutoExecute()
    if not AutoExecute then
        return true
    end

    local queueFunction =
        Env.queue_on_teleport
        or Env.queueonteleport

    if type(queueFunction) ~= "function"
        and type(Env.syn) == "table" then
        queueFunction = Env.syn.queue_on_teleport
    end

    if type(queueFunction) ~= "function" then
        return false
    end

    local loaderCode =
        'loadstring(game:HttpGet("' .. LOADER_URL .. '"))()'

    return pcall(function()
        queueFunction(loaderCode)
    end)
end

--==================================================
-- SERVER HOP
--==================================================

local function serverHop()
    if not ServerHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            if not queueAutoExecute() then
                return false
            end

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                return true
            end
        end
    end

    return false
end

--==================================================
-- OPTIMIZATIONS
--==================================================

local function loadOptimization(url)
    if type(loadstring) ~= "function" then
        return
    end

    pcall(function()
        local source = game:HttpGet(url)
        local compiled = loadstring(source)

        if compiled then
            compiled()
        end
    end)
end

task.spawn(function()
    task.wait(2)
    loadOptimization(FIXLAG_URL)

    task.wait(1)
    loadOptimization(NORENDER_URL)
end)

--==================================================
-- MAIN FARM LOOP
--==================================================

while Running do
    local success, err = pcall(function()
        if not waitForAlive() then
            return
        end

        -- 1. Detect and fight a nearby zombie.
        local foughtZombie = fightNearbyZombie()

        -- 2. Immediately scan for candy after fighting.
        if foughtZombie then
            collectCandy()
        else
            -- Continue regular candy collection.
            collectCandy()
        end

        if not Running then
            return
        end

        -- 3. Find current and newly spawned Halloween doors.
        local doors = getDoors()

        if #doors > 0 then
            farmDoor(doors[1].Object)
        end

        if not Running then
            return
        end

        -- 4. Check zombies again after door farming.
        local foughtAnotherZombie = fightNearbyZombie()

        -- 5. Check nearby candy again after the fight.
        if foughtAnotherZombie then
            collectCandy()
        end

        -- 6. Re-scan for new doors.
        getDoors()

        -- 7. Server hop only after all discovered doors are open
        -- and no new door has appeared for the idle period.
        if ServerHop then
            local completed, total = allTreesOpened()

            local quietTime =
                os.clock() - LastDoorDiscovery

            if completed
                and total > 0
                and quietTime >= DOOR_DISCOVERY_IDLE then

                print("[AXOMJB] All discovered doors opened. Server hopping...")

                if serverHop() then
                    Running = false
                    return
                end
            end
        end
    end)

    if not success then
        warn("[AXOMJB] Farm recovered from error:", tostring(err))
    end

    task.wait(SCAN_WAIT)
end
