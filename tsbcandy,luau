
--[[
    AXOMJB - HALLOWEEN AUTOFARM 🎃
    SAFE CANDY COLLECTION
    HALLOWEEN DOOR FARM
    NEARBY ZOMBIE DETECTION
    AUTO RESET + DEATH RECOVERY
    SERVER HOP + AUTO EXECUTE
]]

local Env = (getgenv and getgenv()) or _G

--==================================================
-- SETTINGS
--==================================================

local ServerHop = Env.ServerHop
if ServerHop == nil then
    ServerHop = false
end

local AutoExecute = ServerHop

--==================================================
-- SERVICES
--==================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIGURATION
--==================================================

local OPEN_WAIT = 3
local CANDY_SCAN_RADIUS = 100
local ZOMBIE_SCAN_RADIUS = 60
local TREE_SWITCH_WAIT = 0.5
local SCAN_WAIT = 1

local CANDY_PICKUP_DISTANCE = 5
local CANDY_MOVE_TIMEOUT = 8
local CANDY_RETRY_COOLDOWN = 5
local CANDY_MAX_VERTICAL_DIFFERENCE = 12
local CANDY_GROUND_CHECK_DISTANCE = 35

local DOOR_PATTERN = "^DOOR%s*%d+%s+NEW$"

local LOADER_URL =
    "https://raw.githubusercontent.com/skidbudnoo-prog/Test-Script/refs/heads/main/tsbcandy%2Cluau"

local FIXLAG_URL =
    "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/FixLag.luau"

local NORENDER_URL =
    "https://raw.githubusercontent.com/SkibidiFart123patapim/OpenSource/refs/heads/main/NoRender.luau"

--==================================================
-- RUNTIME
--==================================================

local Running = true
local DoorRegistry = {}
local CountedCandy = {}
local CandyCooldown = {}

--==================================================
-- CANDY NAMES
--==================================================

local CandyNames = {
    BloxRoll = true,
    BloxyDrops = true,
    Chocoblox = true,

    DarkOrangeCandy1 = true,
    DarkOrangeCandy2 = true,
    DarkOrangeCandy3 = true,
    DarkOrangeCandy4 = true,

    MrBloxBar = true,

    OrangeCandy1 = true,
    OrangeCandy2 = true,
    OrangeCandy3 = true,
    OrangeCandy4 = true
}

--==================================================
-- CHARACTER HELPERS
--==================================================

local function getCharacter()
    return Player.Character
end

local function getHumanoid()
    local character = getCharacter()

    return character
        and character:FindFirstChildWhichIsA("Humanoid")
end

local function getRoot()
    local character = getCharacter()

    return character
        and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid = getHumanoid()

    return humanoid ~= nil
        and humanoid.Health > 0
        and getRoot() ~= nil
end

local function waitForAlive()
    while Running do
        if isAlive() then
            return true
        end

        task.wait(0.25)
    end

    return false
end

--==================================================
-- AUTOMATIC RESET ON START
--==================================================

local function resetOnStart()
    if not waitForAlive() then
        return false
    end

    local oldCharacter = getCharacter()
    local humanoid = getHumanoid()

    if not oldCharacter or not humanoid then
        return false
    end

    pcall(function()
        humanoid.Health = 0
    end)

    while Running and Player.Character == oldCharacter do
        task.wait(0.25)
    end

    return waitForAlive()
end

--==================================================
-- OBJECT HELPERS
--==================================================

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--==================================================
-- DOOR TELEPORT
-- Candy collection does NOT use this function.
--==================================================

local function teleportTo(object)
    if not waitForAlive() then
        return false
    end

    local part = getPart(object)

    if not part or not part:IsDescendantOf(Workspace) then
        return false
    end

    local success = pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)

    if success then
        task.wait(0.5)
    end

    return success
end

--==================================================
-- FACE TREE
--==================================================

local function faceTree(door)
    if not waitForAlive() then
        return false
    end

    local part = getPart(door)
    local root = getRoot()

    if not part or not root then
        return false
    end

    return pcall(function()
        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )

        local camera = Workspace.CurrentCamera

        if camera then
            camera.CFrame = CFrame.lookAt(
                camera.CFrame.Position,
                part.Position
            )
        end
    end)
end

--==================================================
-- TREE INTERACTION
--==================================================

local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if not prompt or not prompt.Enabled then
        return false
    end

    local firePrompt = Env.fireproximityprompt

    if type(firePrompt) == "function" then
        local success = pcall(function()
            firePrompt(prompt)
        end)

        if success then
            return true
        end
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end)
end

--==================================================
-- FIND HALLOWEEN DOORS
--==================================================

local function getDoors()
    local folder = Workspace:FindFirstChild(
        "HalloweenDoorTrees"
    )

    if not folder then
        return {}
    end

    local template = folder:FindFirstChild(
        "DoorTreeTemplate"
    )

    if not template then
        return {}
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then

            table.insert(doors, object)
            DoorRegistry[object] = true
        end
    end

    table.sort(doors, function(a, b)
        local aNumber = tonumber(a.Name:match("%d+")) or 0
        local bNumber = tonumber(b.Name:match("%d+")) or 0

        return aNumber < bNumber
    end)

    return doors
end

--==================================================
-- CHECK OPENED DOORS
--==================================================

local function isDoorOpened(door)
    if not door or not door:IsDescendantOf(Workspace) then
        return true
    end

    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt then
        return not prompt.Enabled
    end

    return false
end

local function allTreesOpened()
    local total = 0

    for door in pairs(DoorRegistry) do
        total = total + 1

        if not isDoorOpened(door) then
            return false, total
        end
    end

    return total > 0, total
end

--==================================================
-- NEARBY ZOMBIE DETECTION
--==================================================

local function getZombies()
    local zombies = {}
    local root = getRoot()

    if not root then
        return zombies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            local part = getPart(object)

            if humanoid
                and humanoid.Health > 0
                and part then

                local distance =
                    (part.Position - root.Position).Magnitude

                if distance <= ZOMBIE_SCAN_RADIUS then
                    table.insert(zombies, {
                        Model = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(zombies, function(a, b)
        return a.Distance < b.Distance
    end)

    return zombies
end

--==================================================
-- ATTACK NEARBY ZOMBIES
--==================================================

local function attackZombies()
    if not waitForAlive() then
        return
    end

    local zombies = getZombies()

    for _, entry in ipairs(zombies) do
        if not Running or not waitForAlive() then
            return
        end

        local zombie = entry.Model

        if zombie and zombie.Parent then
            pcall(function()
                local target = getPart(zombie)
                local root = getRoot()

                if not target or not root then
                    return
                end

                local distance =
                    (target.Position - root.Position).Magnitude

                if distance > ZOMBIE_SCAN_RADIUS then
                    return
                end

                root.CFrame = CFrame.lookAt(
                    root.Position,
                    target.Position
                )

                for _ = 1, 5 do
                    if not Running or not zombie.Parent then
                        break
                    end

                    if not waitForAlive() then
                        break
                    end

                    local zombieHumanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not zombieHumanoid
                        or zombieHumanoid.Health <= 0 then
                        break
                    end

                    local character = getCharacter()

                    local tool = character
                        and character:FindFirstChildWhichIsA("Tool")

                    if tool then
                        pcall(function()
                            tool:Activate()
                        end)
                    end

                    task.wait(0.35)
                end
            end)
        end
    end
end

--==================================================
-- SAFE CANDY PART FINDER
--==================================================

local function getCandyPart(object, root)
    if not object or not root then
        return nil
    end

    local bestPart = nil
    local bestDistance = math.huge

    if object:IsA("BasePart") then
        local distance =
            (object.Position - root.Position).Magnitude

        bestPart = object
        bestDistance = distance
    end

    for _, item in ipairs(object:GetDescendants()) do
        if item:IsA("BasePart") then
            local distance =
                (item.Position - root.Position).Magnitude

            if distance < bestDistance then
                bestDistance = distance
                bestPart = item
            end
        end
    end

    return bestPart
end

--==================================================
-- CHECK SAFE GROUND
--==================================================

local function hasSafeGround(part)
    if not part then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        Player.Character,
        part.Parent
    }

    local origin = part.Position + Vector3.new(0, 5, 0)
    local direction = Vector3.new(
        0,
        -CANDY_GROUND_CHECK_DISTANCE,
        0
    )

    local result = Workspace:Raycast(
        origin,
        direction,
        params
    )

    return result ~= nil
end

--==================================================
-- FIND CLOSEST SAFE CANDY
--==================================================

local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name]
            and not CountedCandy[object]
            and not CandyCooldown[object] then

            local part = getCandyPart(object, root)

            if part then
                local distance =
                    (part.Position - root.Position).Magnitude

                local verticalDifference =
                    math.abs(part.Position.Y - root.Position.Y)

                if distance <= CANDY_SCAN_RADIUS
                    and verticalDifference <= CANDY_MAX_VERTICAL_DIFFERENCE
                    and hasSafeGround(part) then

                    table.insert(candies, {
                        Object = object,
                        Part = part,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--==================================================
-- SAFE CANDY COLLECTION
-- One candy at a time. Never teleports to candy.
--==================================================

local function collectCandy()
    if not waitForAlive() then
        return
    end

    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not waitForAlive() then
            return
        end

        local candy = entry.Object
        local part = entry.Part

        if not candy
            or not candy:IsDescendantOf(Workspace)
            or not part
            or not part:IsDescendantOf(Workspace) then
            continue
        end

        local humanoid = getHumanoid()
        local root = getRoot()

        if not humanoid or not root then
            return
        end

        if not hasSafeGround(part) then
            CandyCooldown[candy] = true

            task.delay(CANDY_RETRY_COOLDOWN, function()
                CandyCooldown[candy] = nil
            end)

            continue
        end

        CandyCooldown[candy] = true

        -- Walk to the nearest candy.
        humanoid:MoveTo(part.Position)

        local startTime = os.clock()

        while Running
            and candy:IsDescendantOf(Workspace)
            and os.clock() - startTime < CANDY_MOVE_TIMEOUT do

            if not waitForAlive() then
                return
            end

            root = getRoot()
            part = getCandyPart(candy, root)

            if not root or not part then
                break
            end

            local distance =
                (root.Position - part.Position).Magnitude

            if distance <= CANDY_PICKUP_DISTANCE then
                break
            end

            if not hasSafeGround(part) then
                break
            end

            task.wait(0.25)
        end

        task.wait(1)

        if not candy:IsDescendantOf(Workspace) then
            CountedCandy[candy] = true
            CandyCooldown[candy] = nil
        else
            task.delay(CANDY_RETRY_COOLDOWN, function()
                CandyCooldown[candy] = nil
            end)
        end

        -- One candy per call.
        return
    end
end

--==================================================
-- HALLOWEEN DOOR FARM
--==================================================

local function farmDoor(door)
    if not Running or not waitForAlive() then
        return
    end

    if not door
        or not door:IsDescendantOf(Workspace)
        or isDoorOpened(door) then
        return
    end

    if not teleportTo(door) then
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(OPEN_WAIT)

    if not Running then
        return
    end

    collectCandy()
end

--==================================================
-- AUTO EXECUTE ON SERVER HOP
--==================================================

local function queueAutoExecute()
    if not AutoExecute then
        return true
    end

    local queueFunction =
        Env.queue_on_teleport
        or Env.queueonteleport

    if type(queueFunction) ~= "function"
        and type(Env.syn) == "table" then

        queueFunction = Env.syn.queue_on_teleport
    end

    if type(queueFunction) ~= "function" then
        return false
    end

    local loaderCode =
        'loadstring(game:HttpGet("' .. LOADER_URL .. '"))()'

    return pcall(function()
        queueFunction(loaderCode)
    end)
end

--==================================================
-- SERVER HOP
--==================================================

local function serverHop()
    if not ServerHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess or type(decoded) ~= "table" then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id
            and server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            if not queueAutoExecute() then
                return false
            end

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleportSuccess then
                return true
            end
        end
    end

    return false
end

--==================================================
-- OPTIMIZATION SCRIPTS
--==================================================

local function loadOptimization(url)
    if type(loadstring) ~= "function" then
        return
    end

    pcall(function()
        local source = game:HttpGet(url)
        local compiled = loadstring(source)

        if compiled then
            compiled()
        end
    end)
end

--==================================================
-- MAIN FARM LOOP
--==================================================

task.spawn(function()
    while Running do
        local success, err = pcall(function()
            if not waitForAlive() then
                return
            end

            -- Collect one nearby safe candy.
            collectCandy()

            if not Running then
                return
            end

            -- Search for Halloween doors.
            local doors = getDoors()

            for _, door in ipairs(doors) do
                if not Running or not waitForAlive() then
                    return
                end

                if door
                    and door:IsDescendantOf(Workspace)
                    and not isDoorOpened(door) then

                    farmDoor(door)
                end

                task.wait(TREE_SWITCH_WAIT)
            end

            if not Running then
                return
            end

            -- Continue candy collection.
            collectCandy()

            -- Attack nearby zombies.
            attackZombies()

            -- Hop only when enabled and doors are complete.
            if ServerHop then
                local completed, total = allTreesOpened()

                if completed and total > 0 then
                    if serverHop() then
                        Running = false
                        return
                    end
                end
            end
        end)

        if not success then
            warn(
                "[AXOMJB] Farm recovered from error:",
                tostring(err)
            )
        end

        task.wait(SCAN_WAIT)
    end
end)

--==================================================
-- STARTUP OPTIMIZATIONS
--==================================================

task.spawn(function()
    task.wait(2)
    loadOptimization(FIXLAG_URL)

    task.wait(1)
    loadOptimization(NORENDER_URL)
end)

