--// CHARACTER
local function getCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

local function getRoot()
    return getCharacter():WaitForChild("HumanoidRootPart")
end

local function isAlive()
    local humanoid =
        getCharacter():FindFirstChildWhichIsA("Humanoid")

    return humanoid ~= nil and humanoid.Health > 0
end

local function getPart(object)
    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

--// TELEPORT
local function teleportTo(object)
    local part = getPart(object)

    if not part then
        return false
    end

    return pcall(function()
        getCharacter():PivotTo(
            CFrame.new(part.Position + Vector3.new(0, 2, 0))
        )
    end)
end

--// PROMPT INTERACTION
local function interact(object)
    local prompt = object:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt and prompt.Enabled then
        local firePrompt = Env.fireproximityprompt
            or fireproximityprompt

        if type(firePrompt) == "function" then
            local success = pcall(function()
                firePrompt(prompt)
            end)

            if success then
                return true
            end
        end

        local success = pcall(function()
            prompt:InputHoldBegin()
            prompt:InputHoldEnd()
        end)

        if success then
            return true
        end
    end

    local success = pcall(function()
        VirtualInputManager:SendKeyEvent(
            true,
            Enum.KeyCode.E,
            false,
            game
        )

        task.wait(0)

        VirtualInputManager:SendKeyEvent(
            false,
            Enum.KeyCode.E,
            false,
            game
        )
    end)

    return success
end

--// FACE TREE
local function faceTree(door)
    local part = getPart(door)

    if not part then
        return
    end

    pcall(function()
        local root = getRoot()

        root.CFrame = CFrame.lookAt(
            root.Position,
            Vector3.new(
                part.Position.X,
                root.Position.Y,
                part.Position.Z
            )
        )
    end)
end

--// FIND DOORS
local function getDoors()
    local folder =
        Workspace:FindFirstChild("HalloweenDoorTrees")

    if not folder then
        return {}
    end

    local template =
        folder:FindFirstChild("DoorTreeTemplate")

    if not template then
        return {}
    end

    local doors = {}

    for _, object in ipairs(template:GetDescendants()) do
        if object.Name:match(DOOR_PATTERN)
            and getPart(object) then

            table.insert(doors, object)
        end
    end

    table.sort(doors, function(a, b)
        local an = tonumber(a.Name:match("%d+")) or 0
        local bn = tonumber(b.Name:match("%d+")) or 0
        return an < bn
    end)

    return doors
end

--// FIND NEARBY CANDY
local function getCandies()
    local candies = {}
    local root = getRoot()

    if not root then
        return candies
    end

    local position = root.Position

    for _, object in ipairs(Workspace:GetDescendants()) do
        if CandyNames[object.Name] then
            local part = getPart(object)

            if part then
                local distance =
                    (part.Position - position).Magnitude

                if distance <= SETTINGS.CandyRadius then
                    table.insert(candies, {
                        Object = object,
                        Distance = distance
                    })
                end
            end
        end
    end

    table.sort(candies, function(a, b)
        return a.Distance < b.Distance
    end)

    return candies
end

--// COLLECT CANDY
local function collectCandy()
    if not SETTINGS.CandyFarm or not Running then
        return
    end

    local candies = getCandies()

    for _, entry in ipairs(candies) do
        if not Running or not isAlive() then
            return
        end

        local candy = entry.Object

        if candy and candy:IsDescendantOf(Workspace) then
            teleportTo(candy)
            task.wait(SETTINGS.CandyWait)

            if not candy:IsDescendantOf(Workspace) then
                CandyCount = CandyCount + 1
            end
        end
    end
end

--// FIND ZOMBIES
local function getZombies()
    local zombies = {}

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "HalloweenZombie"
            and object:IsA("Model") then

            local humanoid =
                object:FindFirstChildWhichIsA("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(zombies, object)
            end
        end
    end

    return zombies
end

--// ZOMBIE ATTACK
local function attackZombies()
    if not SETTINGS.KillZombies or not Running then
        return
    end

    for _, zombie in ipairs(getZombies()) do
        if not Running or not isAlive() then
            return
        end

        pcall(function()
            local target = getPart(zombie)

            if not target then
                return
            end

            local character = getCharacter()
            local root = getRoot()

            root.CFrame = CFrame.lookAt(
                root.Position,
                target.Position
            )

            local tool =
                character:FindFirstChildWhichIsA("Tool")

            if tool then
                for _ = 1, 5 do
                    if not Running or not zombie.Parent then
                        break
                    end

                    local humanoid =
                        zombie:FindFirstChildWhichIsA("Humanoid")

                    if not humanoid or humanoid.Health <= 0 then
                        break
                    end

                    tool:Activate()
                    task.wait(0.35)
                end
            end
        end)
    end
end

--// SERVER HOP
local function serverHop()
    if not SETTINGS.AutoHop then
        return false
    end

    local requestFunction =
        Env.request
        or Env.http_request
        or request
        or http_request

    if type(requestFunction) ~= "function" then
        return false
    end

    local url =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local success, response = pcall(function()
        return requestFunction({
            Url = url,
            Method = "GET"
        })
    end)

    if not success or not response then
        return false
    end

    if (response.StatusCode or response.Status) ~= 200 then
        return false
    end

    local decodedSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decodedSuccess then
        return false
    end

    for _, server in ipairs(decoded.data or {}) do
        if server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            local teleported = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    Player
                )
            end)

            if teleported then
                return true
            end
        end
    end

    return false
end

--// FARM ONE TREE
local function farmDoor(door)
    if not Running
        or not door
        or not door:IsDescendantOf(Workspace) then
        return
    end

    if not isAlive() then
        return
    end

    if not teleportTo(door) then
        return
    end

    faceTree(door)
    task.wait(0.4)

    if not Running then
        return
    end

    interact(door)
    task.wait(SETTINGS.OpenWait)

    if SETTINGS.CandyFarm then
        collectCandy()
    end

    if SETTINGS.KillZombies then
        attackZombies()
    end
end

